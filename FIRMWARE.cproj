    <Compile Include="TEST\test_timer.h">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="TEST\test_uart.c">
      <SubType>compile</SubType>
    </Compile>
    <Compile Include="TEST\test_uart.h">
      <SubType>compile</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="APP" />
    <Folder Include="BSP" />
    <Folder Include="COM_MAC" />
    <Folder Include="DRIVER" />
    <Folder Include="DRIVER\components" />
    <Folder Include="DRIVER\devices" />
    <Folder Include="MW" />
    <Folder Include="TEST" />
  </ItemGroup>
  <Import Project="$(AVRSTUDIO_EXE_PATH)\\Vs\\Compiler.targets" />
</Project>